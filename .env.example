# Base de données (Postgres). En prod, Vercel fournit POSTGRES_URL et
# POSTGRES_URL_NON_POOLING via l'intégration Supabase. Les previews ont leur
# propre base Supabase, connectée avec le préfixe PREVIEW (PREVIEW_POSTGRES_URL…).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/comptoir
# Secret de signature des sessions (32 caractères minimum) : openssl rand -base64 32
AUTH_SECRET=
# Connexion avec Discord (facultatif, voir README) : l'application créée sur
# discord.com/developers. Sans elles, pas de bouton Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
