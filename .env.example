# Base de données (Postgres). En prod, Vercel fournit POSTGRES_URL via l'intégration Supabase.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/comptoir
# Secret de signature des sessions (32 caractères minimum) : openssl rand -base64 32
AUTH_SECRET=
# Application Discord (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Connexion de test pour les tests e2e, jamais active sur Vercel
AUTH_TEST_LOGIN=0
